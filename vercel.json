{
  "crons": [
    { "path": "/api/nightly-reminder", "schedule": "0 22 * * *" },
    { "path": "/api/weekly-digest", "schedule": "0 22 * * 0" }
  ],
  "headers": [
    {
      "source": "/:tenant/headers/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:tenant/logo-nav.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
