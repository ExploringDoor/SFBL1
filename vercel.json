{
  "crons": [
    { "path": "/api/arbiter-ical-sync", "schedule": "0 */6 * * *" }
  ],
  "headers": [
    {
      "source": "/:tenant/headers/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:tenant/logo-nav.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
